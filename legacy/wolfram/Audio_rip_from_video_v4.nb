Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Parallelize", "@"}], "*)"}], 
  RowBox[{
   RowBox[{"Scan", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Function", "[", "\[IndentingNewLine]", 
      RowBox[{"videoFile", ",", "\[IndentingNewLine]", 
       RowBox[{"Module", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "videoObject", ",", "audioTrack", ",", "sanitizedBaseName", ",", 
           "wavOutputFile", ",", "mp3OutputFile"}], "}"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Processing: \>\"", ",", "videoFile"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"videoObject", "=", 
           RowBox[{"Import", "@", "videoFile"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"audioTrack", "=", 
           RowBox[{"Audio", "@", "videoObject"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"sanitizedBaseName", "=", 
           RowBox[{"StringReplace", "[", 
            RowBox[{
             RowBox[{"RemoveDiacritics", "[", 
              RowBox[{"FileBaseName", "@", "videoFile"}], "]"}], ",", 
             RowBox[{
              RowBox[{"WhitespaceCharacter", ".."}], "\[Rule]", 
              "\"\<_\>\""}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"wavOutputFile", "=", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"outputFolder", ",", 
              RowBox[{"sanitizedBaseName", "<>", "wavExportFormat"}]}], "}"}],
             "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"mp3OutputFile", "=", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"outputFolder", ",", 
              RowBox[{"sanitizedBaseName", "<>", "mp3ExportFormat"}]}], "}"}],
             "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"Export", "[", "\[IndentingNewLine]", 
           RowBox[{"wavOutputFile", ",", "audioTrack", ",", 
            RowBox[{"SampleRate", "\[Rule]", "16000"}], ",", 
            RowBox[{"AudioEncoding", "\[Rule]", "\"\<Integer16\>\""}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Export", "[", 
           RowBox[{"mp3OutputFile", ",", "audioTrack", ",", "\"\<MP3\>\""}], 
           "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Exported WAV: \>\"", ",", "wavOutputFile"}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Exported MP3: \>\"", ",", "mp3OutputFile"}], "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}]}], "]"}], ",", "videoFiles"}],
